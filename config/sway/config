# Sway config file, derived from my previous i3 config

set $mod Mod4

set $term alacritty
set $screenshot_dir $(xdg-user-dir PICTURES)

# --- Session ---------------------------------------------------------------

# Arch's drop-ins import DISPLAY, WAYLAND_DISPLAY, SWAYSOCK and
# XDG_CURRENT_DESKTOP into systemd and D-Bus, which xdg-desktop-portal needs
# for screen sharing. Included first so everything below inherits them.
include /etc/sway/config.d/*

# XDG autostart, which also starts KeePassXC, Nextcloud and the polkit agent.
# Every .desktop file in /etc/xdg/autostart runs too: hide an unwanted one
# with a same-named copy in ~/.config/autostart containing Hidden=true.
exec dex --autostart --environment sway

# Notification daemon (configured in ~/.config/mako/config)
exec mako

# Clipboard history: cliphist records every copy; text and images need
# separate watchers. Browse past entries with $mod+Shift+v.
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# Keep clipboard contents alive after the source window closes — Wayland drops
# them otherwise.
exec wl-clip-persist --clipboard regular

# --- Appearance ------------------------------------------------------------

# Window titles only show in tabbed and stacked layouts.
font pango:Hack Nerd Font 11

# Wallpaper for every output; monitor geometry is set per-machine below.
output * bg ~/background.png stretch

default_border none
default_floating_border pixel 2
smart_gaps on
gaps inner 10

# Kanagawa Wave, as in waybar, mako and swaylock.
# class                 border  bg      text    indicator child_border
client.focused          #7e9cd8 #2d4f67 #dcd7ba #7e9cd8   #7e9cd8
client.focused_inactive #2a2a37 #2a2a37 #c8c093 #2a2a37   #2a2a37
client.unfocused        #1f1f28 #1f1f28 #727169 #1f1f28   #1f1f28
client.urgent           #e82424 #e82424 #1f1f28 #e82424   #e82424

# Display layout (mode/position) is machine-specific. Each machine has its
# own file named after its hostname (e.g. cthulhu.conf), deployed into
# ~/.config/sway/outputs.d/ from the dotfiles-private repo. sway runs include
# paths through wordexp, so $(hostname) is substituted at load time. A host
# with no matching file just logs a harmless warning and falls back to sway's
# output autodetection.
include ~/.config/sway/outputs.d/$(hostname).conf

# --- Input -----------------------------------------------------------------

input type:keyboard {
    xkb_layout "us,it,se"
}

# --- Hardware keys ---------------------------------------------------------

# --locked keeps these working on the lock screen.
# Use wpctl to adjust volume in Wireplumber. Waybar tracks the volume on its
# own, so no bar refresh is needed. -l 1.0 caps the volume at 100%.
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

bindsym --locked XF86MonBrightnessUp exec brightnessctl set +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

# Screenshots go to the Pictures directory: Print takes every output,
# Shift+Print a selected area.
bindsym Print exec grim "$screenshot_dir/screenshot-$(date +%Y%m%d-%H%M%S).png"
bindsym Shift+Print exec area=$(slurp) && grim -g "$area" "$screenshot_dir/screenshot-$(date +%Y%m%d-%H%M%S).png"

# ThinkPad hardware keys. XF86Keyboard (keycode 374) and
# XF86SelectiveScreenshot (634) sit above the 255 the X11 protocol allows,
# so they bind under xkbcommon but have no i3 equivalent.
# The bluetooth key is claimed by the kernel rfkill handler before sway sees
# it; a binding here would fire on top of the radio toggle.
bindsym XF86Keyboard input type:keyboard xkb_switch_layout next
bindsym XF86Favorites exec brave
bindsym XF86Tools exec $term
bindsym XF86SelectiveScreenshot exec area=$(slurp) && grim -g "$area" "$screenshot_dir/screenshot-$(date +%Y%m%d-%H%M%S).png"

# Refuses to switch the panel off while it is the only active output.
bindsym XF86Display exec ~/.config/sway/scripts/toggle-internal-display

# --- Launchers -------------------------------------------------------------

bindsym $mod+Return exec $term
bindsym $mod+d exec fuzzel
bindsym $mod+apostrophe exec firefox

# clipboard history: pick a past entry with fuzzel and copy it back
bindsym $mod+Shift+v exec cliphist list | fuzzel --dmenu | cliphist decode | wl-copy

# dismiss the latest / all notifications
bindsym $mod+n exec makoctl dismiss
bindsym $mod+Shift+n exec makoctl dismiss --all

# --- Windows ---------------------------------------------------------------

bindsym $mod+Shift+q kill

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod normal

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+b split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
bindsym $mod+z focus child

# Scratchpad: stash the focused window, then cycle through stashed ones.
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Dialogs and small utilities float. window_role and window_type only match
# Xwayland windows; native Wayland ones are matched by app_id.
for_window [window_role="alert"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="blueman-manager"] floating enable

# --- Workspaces ------------------------------------------------------------

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# --- Modes -----------------------------------------------------------------

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# --- Session control -------------------------------------------------------

# Reload the configuration file. sway has no in-place restart like i3's.
bindsym $mod+Shift+c reload

bindsym $mod+Shift+p exec swaylock

# Exit and power-off ask first; a stray chord should not end the session.
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway? This ends your Wayland session.' -B 'Exit sway' 'swaymsg exit'
bindsym $mod+Shift+Delete exec 'systemctl poweroff'

# --- Bar -------------------------------------------------------------------

# Status bar: Waybar (configured in ~/.config/waybar/). sway manages its
# lifecycle via swaybar_command, so it restarts on reload.
bar {
        swaybar_command waybar
}
